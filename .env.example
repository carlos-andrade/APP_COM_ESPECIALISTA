# Copy to .env locally; never commit real credentials.
CPE_DB_PATH=data/cpe.sqlite3
# For PostgreSQL/Compose, set DATABASE_URL instead of relying on SQLite.
DATABASE_URL=
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
CPE_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
CPE_JWT_TTL_SECONDS=3600
CPE_RATE_LIMIT_PER_MINUTE=60
CPE_ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_ONE_TIME_SECRET
OPENAI_API_KEY=
CPE_OPENAI_MODEL=gpt-4.1-mini
